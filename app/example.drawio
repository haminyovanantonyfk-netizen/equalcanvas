<mxfile><diagram id="example" name="Community library"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="start" value="Find a book" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6f0d5;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="available" value="Is it available?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="borrow" value="Borrow the book" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="reserve" value="Join the waiting list" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="320" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="enjoy" value="Read &amp; return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6f0d5;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="a" edge="1" source="start" target="available" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b" value="Yes" edge="1" source="available" target="borrow" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c" value="Not yet" edge="1" source="available" target="reserve" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="d" edge="1" source="borrow" target="enjoy" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e" value="Book returned" edge="1" source="reserve" target="available" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
